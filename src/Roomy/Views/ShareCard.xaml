<UserControl x:Class="Roomy.Views.ShareCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Roomy.Controls"
             Width="1200" Height="630"
             FontFamily="{StaticResource DisplayFont}"
             Foreground="{StaticResource TextBrush}"
             TextOptions.TextFormattingMode="Ideal">
    <Grid Background="{StaticResource BgBrush}" ClipToBounds="True">
        <Grid Margin="80,64,80,60">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <c:LogoMark Width="46" Height="46" />
                <TextBlock Text="Roomy" FontSize="32" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="I just freed" FontSize="40" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding FreedText}" FontSize="148" FontWeight="Bold" Margin="-6,-14,0,-14"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="32" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="24" Padding="28,26"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Before" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding BeforeText}" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <c:UsageBar Height="16" Margin="0,12,0,26" Target="{Binding Before}" Fill="{Binding BeforeBrush}"
                                    Track="{StaticResource Surface2Brush}" />
                        <Grid>
                            <TextBlock Text="After" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding AfterText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <c:UsageBar Height="16" Margin="0,12,0,0" Target="{Binding After}" Fill="{StaticResource AccentBrush}"
                                    Track="{StaticResource Surface2Brush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="roomy.krezio.xyz" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Free · No ads · No account" FontSize="24" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
