<UserControl x:Class="Roomy.Controls.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="False">
    <Viewbox Stretch="Uniform">
        <Grid Width="64" Height="64">
            <Border CornerRadius="18" Background="{StaticResource AccentGradient}" />
            <!-- a usage ring that's mostly empty: "room" -->
            <Ellipse Width="42.5" Height="42.5" Stroke="#26111113" StrokeThickness="6.5" />
            <Path Data="M 32,14 A 18,18 0 1 1 14,32"
                  Stroke="#111113" StrokeThickness="6.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>
    </Viewbox>
</UserControl>
