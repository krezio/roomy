<Window x:Class="Roomy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Roomy.Controls"
        Title="Roomy" Width="1160" Height="780" MinWidth="920" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <DataTemplate x:Key="ScanStepTemplate">
            <Grid Height="34" Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" HorizontalAlignment="Left"
                           FontSize="12" Foreground="{Binding GlyphBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{Binding TitleBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemRowTemplate">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource RoomyCheck}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Visibility="{Binding Selectable, Converter={StaticResource VisIf}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource FaintBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0"
                            Content="Uninstall in Steam" Command="{Binding UninstallCommand}"
                            Visibility="{Binding IsSteam, Converter={StaticResource VisIf}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Show in File Explorer"
                            Command="{Binding RevealCommand}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryTemplate">
            <Border Style="{StaticResource Card}" CornerRadius="16" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="18,16,14,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource RoomyCheck}" IsChecked="{Binding IsSelected}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Visibility="{Binding CanSelect, Converter={StaticResource VisIf}}" />
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{StaticResource Surface2Brush}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="19"
                                       Foreground="{Binding IconBrush}" />
                        </Border>
                        <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                        Visibility="{Binding HasNote, Converter={StaticResource VisIf}}">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12"
                                           Foreground="{StaticResource WarnBrush}" />
                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource WarnBrush}"
                                           Margin="7,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Border Grid.Column="4" CornerRadius="99" Padding="10,4" Background="{Binding BadgeBg}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SafetyText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding BadgeFg}" />
                        </Border>
                        <Button Grid.Column="5" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                Content="{Binding ChevronGlyph}" Command="{Binding ToggleExpandCommand}"
                                Visibility="{Binding HasDetails, Converter={StaticResource VisIf}}" />
                    </Grid>

                    <Border Visibility="{Binding IsExpanded, Converter={StaticResource VisIf}}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,8,14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="38,6,0,6"
                                        Visibility="{Binding IsBlocked, Converter={StaticResource VisIf}}">
                                <Button Style="{StaticResource SecondaryButton}" Padding="14,8" Content="Restart as admin"
                                        Command="{Binding RestartAdminCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="38,6,0,6"
                                        Visibility="{Binding IsSettings, Converter={StaticResource VisIf}}">
                                <Button Style="{StaticResource SecondaryButton}" Padding="14,8" Command="{Binding OpenSettingsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" />
                                        <TextBlock Text="Remove it with Windows" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Settings → Storage → Temporary files → Previous Windows installation(s)"
                                           Foreground="{StaticResource FaintBrush}" FontSize="12" VerticalAlignment="Center"
                                           Margin="14,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource ItemRowTemplate}"
                                          Visibility="{Binding ShowItemList, Converter={StaticResource VisIf}}" />
                            <TextBlock Text="{Binding HiddenText}" Foreground="{StaticResource FaintBrush}" FontSize="12"
                                       Margin="38,6,0,0" Visibility="{Binding HasHidden, Converter={StaticResource VisIf}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SpaceRowTemplate">
            <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}">
                <Grid Height="46" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="2*" MinWidth="150" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" HorizontalAlignment="Left"
                               FontSize="15" Foreground="{Binding GlyphBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
                    <Grid Grid.Column="2" Height="8" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding BarWidth}" />
                            <ColumnDefinition Width="{Binding RestWidth}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{StaticResource Surface2Brush}" />
                        <Border CornerRadius="4" Background="{Binding BarBrush}" />
                    </Grid>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{Binding PercentText}" FontSize="12" Foreground="{StaticResource FaintBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in File Explorer"
                            HorizontalAlignment="Right" Command="{Binding RevealCommand}"
                            Visibility="{Binding CanReveal, Converter={StaticResource VisIf}}" />
                </Grid>
            </Button>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ title bar ============ -->
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <c:LogoMark Width="20" Height="20" />
                    <TextBlock Text="Roomy" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0" CornerRadius="6" Padding="7,2" Background="{StaticResource WarnSoftBrush}"
                            VerticalAlignment="Center" Visibility="{Binding ShowAdminBadge, Converter={StaticResource VisIf}}">
                        <TextBlock Text="ADMIN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Min_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Max_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">

                <!-- ============ HOME ============ -->
                <Grid x:Name="HomeView">
                    <StackPanel MaxWidth="780" Margin="48,0,48,44" VerticalAlignment="Center">
                        <TextBlock Text="Let's make some room." FontSize="44" FontWeight="Bold"
                                   FontFamily="{StaticResource DisplayFont}" />
                        <TextBlock Margin="0,10,0,30" FontSize="16.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Roomy finds what's filling up your PC and tells you, in plain English, what's safe to delete." />

                        <Border Style="{StaticResource Card}" Padding="28" DataContext="{Binding SystemDrive}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Surface2Brush}">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="99" Padding="12,5" Background="{Binding StatusBg}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,14">
                                    <TextBlock Text="{Binding FreeNumber}" FontSize="50" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                                    <TextBlock Text="{Binding FreeRest}" FontSize="17" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Bottom" Margin="12,0,0,12" />
                                </StackPanel>
                                <c:UsageBar Grid.Row="2" Height="12" Target="{Binding UsedFraction}" Fill="{Binding BarBrush}"
                                            Track="{StaticResource Surface2Brush}" />
                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding UsedText}" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                                    <TextBlock Text="{Binding PercentText}" FontSize="12" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding OtherDrives}" Margin="0,12,-10,0"
                                      Visibility="{Binding HasOtherDrives, Converter={StaticResource VisIf}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" CornerRadius="14" Padding="16,14" Margin="0,0,10,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PercentText}" FontSize="12" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <c:UsageBar Height="6" Margin="0,10,0,8" Target="{Binding UsedFraction}" Fill="{Binding BarBrush}"
                                                        Track="{StaticResource Surface2Brush}" />
                                            <TextBlock Text="{Binding FreeShort}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="15" />
                                    <TextBlock Text="Scan my PC" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Takes a few seconds. Nothing gets deleted until you say so."
                                       Foreground="{StaticResource FaintBrush}" FontSize="13" VerticalAlignment="Center" Margin="20,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ SCANNING ============ -->
                <Grid x:Name="ScanView" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="640" Margin="0,0,0,30">
                        <Grid Width="112" Height="112">
                            <c:Spinner Thickness="7" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <TextBlock Text="Looking around your PC…" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,28,0,8" FontFamily="{StaticResource DisplayFont}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Found " Foreground="{StaticResource MutedBrush}" FontSize="15" />
                            <c:AnimatedBytes Bytes="{Binding ScanFound}" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="SemiBold" Duration="500" />
                            <TextBlock Text=" you can safely clean so far" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                        </StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,28,0,0" Padding="16,12">
                            <ItemsControl ItemsSource="{Binding ScanSteps}" ItemTemplate="{StaticResource ScanStepTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ RESULTS ============ -->
                <Grid x:Name="ResultsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="40,10,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="We found" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <c:AnimatedBytes Bytes="{Binding SafeTotal}" FontSize="50" FontWeight="Bold" Duration="1200"
                                                 FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource AccentGradient}" />
                                <TextBlock Text="safe to clean" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="14,0,0,11" />
                            </StackPanel>
                            <TextBlock Text="{Binding ReviewSummary}" FontSize="13" Foreground="{StaticResource FaintBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Bottom" CornerRadius="12" Padding="4"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentTab}" GroupName="tabs" Content="Cleanup" IsChecked="{Binding IsCleanupTab}" />
                                <RadioButton Style="{StaticResource SegmentTab}" GroupName="tabs" Content="Space map" IsChecked="{Binding IsSpaceTab}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- cleanup tab -->
                    <ScrollViewer x:Name="CleanupScroll" Grid.Row="1" Margin="40,20,30,0" Padding="0,0,10,16"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsCleanupTab, Converter={StaticResource VisIf}}">
                        <StackPanel>
                            <Border Visibility="{Binding ShowAdminBanner, Converter={StaticResource VisIf}}" CornerRadius="14"
                                    Background="#12F2C14E" BorderBrush="#33F2C14E" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource WarnBrush}" />
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="Windows keeps some of the biggest leftovers locked." FontWeight="SemiBold" />
                                        <TextBlock Text="Restart Roomy as admin to check Windows Update files too." FontSize="13"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                            Content="Restart as admin" Command="{Binding RestartAdminCommand}" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                                        Visibility="{Binding NothingFound, Converter={StaticResource VisIf}}">
                                <TextBlock Text="Your PC is already squeaky clean ✨" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Check the Space map tab to see what's actually using your space."
                                           Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- space map tab -->
                    <Grid Grid.Row="1" Margin="40,20,40,24" DataContext="{Binding SpaceMap}"
                          Visibility="{Binding DataContext.IsSpaceTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisIf}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="18,16,18,8">
                                    <ItemsControl ItemsSource="{Binding Drives}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DrivePill}" Content="{Binding Title}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="13"
                                            Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="12,0,18,6" Visibility="{Binding HasData, Converter={StaticResource VisIf}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding UpCommand}"
                                            IsEnabled="{Binding CanGoUp}" ToolTip="Up one folder" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Crumbs}" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="›" Foreground="{StaticResource FaintBrush}" Margin="8,0" FontSize="13"
                                                               Visibility="{Binding ShowSeparator, Converter={StaticResource VisIf}}" />
                                                    <Button Style="{StaticResource LinkButton}" Command="{Binding Command}">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="2" Text="{Binding CurrentSizeText}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="13" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding ShowEmpty, Converter={StaticResource VisIf}}">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource FaintBrush}" />
                                        <TextBlock Text="See exactly what's using your space" FontSize="17" FontWeight="SemiBold"
                                                   Margin="0,14,0,4" HorizontalAlignment="Center" />
                                        <TextBlock Text="Pick a drive and hit Scan. Big drives can take a minute."
                                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding IsScanning, Converter={StaticResource VisIf}}">
                                        <c:Spinner Width="56" Height="56" Thickness="5" />
                                        <TextBlock Text="Mapping your drive…" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,4" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <ScrollViewer Padding="8,0,8,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasData, Converter={StaticResource VisIf}}">
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SpaceRowTemplate}" />
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="18,18,18,8">
                                    <TextBlock Text="Biggest files" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="The single files taking up the most room." FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" Padding="8,0,8,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding BigFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Command="{Binding RevealCommand}" ToolTip="Show in File Explorer">
                                                    <Grid Height="52" Margin="10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- bottom bar -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsCleanupTab, Converter={StaticResource VisIf}}">
                        <Grid Margin="40,14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Selected to clean" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <c:AnimatedBytes Bytes="{Binding SelectedTotal}" FontSize="22" FontWeight="Bold" Duration="450" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Content="Scan again" Command="{Binding ScanCommand}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" />
                                        <TextBlock Text="{Binding CleanButtonText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ CLEANING ============ -->
                <Grid x:Name="CleanView" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480" Margin="0,0,0,30">
                        <Grid Width="112" Height="112">
                            <c:Spinner Thickness="7" />
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <TextBlock Text="Cleaning up…" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,28,0,8" FontFamily="{StaticResource DisplayFont}" />
                        <TextBlock Text="{Binding CleanStep}" Foreground="{StaticResource MutedBrush}" FontSize="15" HorizontalAlignment="Center" />
                        <c:UsageBar Height="8" Margin="0,28,0,0" Target="{Binding CleanProgress}"
                                    Fill="{StaticResource AccentGradient}" Track="{StaticResource Surface2Brush}" />
                        <TextBlock Text="Files that are in use get skipped, never forced." Foreground="{StaticResource FaintBrush}"
                                   FontSize="12.5" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ============ DONE ============ -->
                <Grid x:Name="DoneView" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0,0,0,30">
                        <Border x:Name="DoneCheck" Width="84" Height="84" CornerRadius="42" Background="{StaticResource AccentGradient}"
                                HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="36" Foreground="#111113" />
                        </Border>
                        <TextBlock Text="You just freed" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,26,0,0" />
                        <c:AnimatedBytes Bytes="{Binding Freed}" FontSize="78" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                         Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Center" Duration="1500" />
                        <TextBlock Text="{Binding DoneSubtitle}" FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />

                        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,26,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Before" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding BeforeText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <c:UsageBar Height="10" Margin="0,8,0,16" Target="{Binding BeforeFraction}" Fill="{Binding BeforeBrush}"
                                            Track="{StaticResource Surface2Brush}" />
                                <Grid>
                                    <TextBlock Text="After" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding AfterText}" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <c:UsageBar Height="10" Margin="0,8,0,0" Target="{Binding AfterFraction}" Fill="{StaticResource AccentBrush}"
                                            Track="{StaticResource Surface2Brush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding SkippedText}" FontSize="12.5" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,14,0,0" Visibility="{Binding HasSkipped, Converter={StaticResource VisIf}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ShareCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Share my result" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Content="Done" Command="{Binding HomeCommand}" Margin="10,0,0,0" Padding="22,12" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ confirm dialog ============ -->
        <Grid Background="#B8000000" Visibility="{Binding ConfirmVisible, Converter={StaticResource VisIf}}">
            <Border Width="470" Style="{StaticResource Card}" Background="{StaticResource Surface2Brush}" Padding="26"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding ConfirmBody}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,22" LineHeight="21" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding ConfirmNoCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmYesText}" Command="{Binding ConfirmYesCommand}" Padding="20,12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ demo-video cursor (only used when recording) ============ -->
        <Canvas x:Name="FakeCursorLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Ellipse x:Name="ClickRing" Width="40" Height="40" Stroke="#F4F4F5" StrokeThickness="2" Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Path x:Name="FakeCursor" Data="M0,0 L0,18 L4.6,13.6 L7.8,21 L11,19.6 L7.9,12.4 L13.6,12.4 Z"
                  Fill="White" Stroke="#111113" StrokeThickness="1.3" StrokeLineJoin="Round">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                </Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- ============ toast ============ -->
        <Border x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,100"
                CornerRadius="12" Background="#F2222226" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Padding="18,11" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding ToastText}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
